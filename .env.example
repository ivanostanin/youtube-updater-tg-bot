# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# YouTube API Configuration
YOUTUBE_API_KEY=your_youtube_api_key_here

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# Webhook Configuration
WEBHOOK_HOST=localhost
WEBHOOK_PORT=8000
WEBHOOK_PATH=/webhook/youtube

# Webhook Callback URL (publicly accessible URL for YouTube notifications)
# Development: Use localhost for local testing
# Production: Must use HTTPS (e.g., https://<hostname>/webhook/youtube)
WEBHOOK_CALLBACK_URL=http://localhost:8000/webhook/youtube

# Logging Configuration
# Set to DEBUG locally to enable structured tracing logs
LOG_LEVEL=INFO

# Localization
# Supported values: en, ru, de
DEFAULT_LOCALE=en

# PubSub Lease Renewal Configuration
# Interval (seconds) at which the background job scans for expiring leases
PUBSUB_LEASE_RENEWAL_INTERVAL=3600
# Renew leases when they expire within this many seconds (default 6 hours)
PUBSUB_LEASE_RENEWAL_THRESHOLD=21600
# Optional limit on how many channels are processed per cycle (set to empty for unlimited)
PUBSUB_LEASE_RENEWAL_BATCH_LIMIT=50
