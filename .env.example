# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# YouTube API Configuration
YOUTUBE_API_KEY=your_youtube_api_key_here

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# Webhook Configuration
WEBHOOK_HOST=localhost
WEBHOOK_PORT=8000
WEBHOOK_PATH=/webhook/youtube

# Webhook Callback URL (publicly accessible URL for YouTube notifications)
# Development: Use localhost for local testing
# Production: Must use HTTPS (e.g., https://<hostname>/webhook/youtube)
WEBHOOK_CALLBACK_URL=http://localhost:8000/webhook/youtube

# Logging Configuration
# Set to DEBUG locally to enable structured tracing logs
LOG_LEVEL=INFO

# Localization
# Supported values: en, ru, de
# Telegram language codes (for example en-US or es) normalize to supported values
# and any unsupported code falls back to DEFAULT_LOCALE
DEFAULT_LOCALE=en

# PubSub Lease Renewal Configuration
# Interval (seconds) at which the background job scans for expiring leases
PUBSUB_LEASE_RENEWAL_INTERVAL=3600
# Renew leases when they expire within this many seconds (default 6 hours)
PUBSUB_LEASE_RENEWAL_THRESHOLD=21600
# Optional limit on how many channels are processed per cycle (set to empty for unlimited)
PUBSUB_LEASE_RENEWAL_BATCH_LIMIT=50

# DM Channel Context (Feature 1.15)
# Minutes that a channel selection remains active for DM commands before expiring
DM_CHANNEL_CONTEXT_TTL_MINUTES=60

# DM Channel Onboarding Notes
# 1. Add the bot as a channel administrator with can_post_messages, can_delete_messages, and can_edit_messages enabled.
# 2. Run /channel_link from a private DM using @channel usernames, numeric IDs (-100...), or the full https://t.me/+invite token for private channels.
# 3. If Telegram still rejects the invite link, forward a recent post from the channel to the DM and reply with /channel_link so the forwarded metadata reveals the chat_id.
# 4. Keep LOG_LEVEL=DEBUG when debugging onboarding issues to surface LinkChannelSuccess/ChannelSelectionDenied traces in the logs.
# 5. Use /channel_unlink (while the channel context is active) to revoke admin links and purge subscriptions/webhooks for that channel when you want to offboard it.
